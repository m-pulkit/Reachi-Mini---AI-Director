# Copy to .env and fill in. Every value here is optional except the API key of your provider.

# ---- Brain (VLM) ----
# gemini | anthropic | mock (offline, no key needed)
VLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# seconds before the robot declares its brain offline
VLM_TIMEOUT=45
VLM_MAX_RETRIES=1

# ---- Robot ----
# auto (physical -> sim fallback) | physical | sim
REACHY_MODE=auto
REACHY_HOST=reachy-mini.local
REACHY_CONNECT_TIMEOUT=5
# true = run MuJoCo without its 3D window (starts faster, fewer start-up errors)
SIM_HEADLESS=false
# true = leave the simulator running after the app exits (next start is instant)
SIM_KEEP_ALIVE=false
# webcam used if the robot/sim camera gives no frames (-1 = off)
FALLBACK_CAMERA_INDEX=0
# true = use Pollen's recorded emotion clips (HF dataset) when available
USE_RECORDED_EMOTIONS=false

# ---- Vision ----
# frames kept per second of the take
SAMPLE_FPS=2
MAX_TAKE_SECONDS=90
MAX_FRAMES_TO_VLM=60
FRAME_WIDTH=640

# ---- Audio ----
# e.g. "Reachy" to pick the robot's mic array by name
MIC_NAME_HINT=
MIC_DEVICE_INDEX=
SPEECH_LANGUAGE=en-US
# true = must say "Reachy ... rolling"
REQUIRE_ROBOT_NAME=false

# ---- Voice ----
TTS_RATE=185
# substring of an installed voice name, e.g. "Zira" or "David"
TTS_VOICE_HINT=

# ---- Misc ----
# live camera window with R / C / Q keyboard shortcuts
SHOW_PREVIEW=true
# save the frames + transcript sent to the VLM (empty = off)
SAVE_TAKES_DIR=takes
LOG_LEVEL=INFO
